# YOLO Vision Service Integration
AI_API_URL=http://127.0.0.1:8001
AI_API_KEY=your_shared_ai_api_key_secret

# Decentralised Intelligence Engine
INTELLIGENCE_CRON=*/15 * * * *
DEMAND_SPIKE_Z_WARN=2.0
DEMAND_SPIKE_Z_CRIT=3.0
SLOW_STOCK_WARN_DAYS=30
SLOW_STOCK_CRIT_DAYS=60

# Initial Seed Credentials
